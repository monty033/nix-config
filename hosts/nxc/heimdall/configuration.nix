{ config, pkgs, modulesPath, inputs, outputs, ... }:
{
  imports = [
    # Autogenerated configuration specific to the iso, and not included in repo
    (modulesPath + "/virtualisation/proxmox-lxc.nix")
  ];

  # Heimdall — read-only Sodola switch console.
  #
  # Phase 1 reads one switch and serves it on 9140. The service is pinned to a
  # reviewed commit of the application repository and runs unprivileged with no
  # ability to reach anything except the switch it reads.
  #
  # Address: 192.168.86.140/24, gateway 192.168.86.1 (assigned by nxc-gen at
  # creation time; there is no network config in this file by design).

  environment.systemPackages = with pkgs; [
    curl
    jq
  ];

  # The hostname comes from Proxmox, not from here: proxmox-lxc.nix defaults
  # manageNetwork and manageHostName to false and, inside that !manageNetwork
  # block, forces networking.hostName to the empty string. With manageNetwork
  # enabled the option would be honoured, so nxc-gen must be given "heimdall".
  system.stateVersion = "26.05";

  extra-services.tailscale = {
    enable = true;
    lxc = true;
  };
  extra-services.host-checkin.enable = true;

  services.openssh.enable = true;

  # Secrets for the console. Every name must exist as a top-level key in
  # secrets/secrets.yaml, or the sops manifest check fails the build. All eight
  # are present on master. They are root-owned, mode 0400, so root can read
  # them. The console service receives them through LoadCredential when it lands.
  sops.secrets = {
    "switch-192-168-86-2-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "switch-192-168-86-3-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "switch-192-168-86-4-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "switch-192-168-86-5-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "switch-192-168-86-6-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "opnsense-console-api" = { owner = "root"; group = "root"; mode = "0400"; };
    "omada-console-openapi" = { owner = "root"; group = "root"; mode = "0400"; };
    "proxmox-console-token" = { owner = "root"; group = "root"; mode = "0400"; };
  };

  # The console's whole configuration. Kept here rather than in the public
  # repository, because it names the site's switch, its management address and
  # the credential to read it with.
  environment.etc."heimdall/config.json".text = builtins.toJSON {
    listen = { host = "0.0.0.0"; port = 9140; };
    poll_seconds = 60;
    switches = [
      {
        name = "core";
        family = "hydra";
        host = "192.168.86.2";
        port = 80;
        scheme = "http";
        username = "admin";
        credential = "switch-192-168-86-2-password";
      }
    ];
  };

  users.users.heimdall = {
    isSystemUser = true;
    group = "heimdall";
    # Fixed so the egress rule below can name it; this host runs nothing else.
    uid = 991;
  };
  users.groups.heimdall = { };

  systemd.services.heimdall = {
    description = "Heimdall read-only switch console";
    wantedBy = [ "multi-user.target" ];
    after = [ "network-online.target" "sops-install-secrets.service" ];
    wants = [ "network-online.target" ];
    requires = [ "sops-install-secrets.service" ];
    # The switch is on plain HTTP and the login is a client-bound session, so a
    # failed poll is retried rather than treated as fatal.
    startLimitIntervalSec = 0;
    serviceConfig = {
      Type = "simple";
      # The credential file lands in this directory, which the console reads by
      # name. Values never appear in the unit, the config or the environment.
      LoadCredential = [ "switch-192-168-86-2-password:/run/secrets/switch-192-168-86-2-password" ];
      ExecStart = "${inputs.heimdall.packages.${pkgs.stdenv.hostPlatform.system}.default}/bin/heimdall /etc/heimdall/config.json";
      User = "heimdall";
      Group = "heimdall";
      Restart = "always";
      RestartSec = 10;
      StateDirectory = "heimdall";
      StateDirectoryMode = "0700";
      UMask = "0077";
      # Reading switch state needs nothing else.
      CapabilityBoundingSet = "";
      AmbientCapabilities = "";
      NoNewPrivileges = true;
      PrivateTmp = true;
      PrivateDevices = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      ProtectKernelTunables = true;
      ProtectKernelModules = true;
      ProtectControlGroups = true;
      ProtectClock = true;
      ProtectHostname = true;
      RestrictAddressFamilies = [ "AF_INET" "AF_INET6" ];
      RestrictNamespaces = true;
      RestrictRealtime = true;
      RestrictSUIDSGID = true;
      LockPersonality = true;
      MemoryDenyWriteExecute = true;
      SystemCallArchitectures = "native";
      SystemCallFilter = [ "@system-service" "~@privileged" "~@resources" ];
      # Best effort only: the cgroup-BPF filter this implements needs the bpf
      # controller, which a container's cgroup does not delegate, so inside
      # this LXC it enforces nothing. It is kept because it costs nothing and
      # does apply on bare metal. The control that actually holds here is the
      # nftables output rule below, keyed on this service's user.
      IPAddressDeny = "any";
      IPAddressAllow = [
        "192.168.86.2/32"
        "127.0.0.1/32"
        "192.168.86.0/24"
        "100.64.0.0/10"
      ];
    };
  };

  # Reachable over the tailnet, and from the LAN itself. Guest (192.168.20.0/24)
  # and IoT (192.168.10.0/24) clients can route to this address, so the source
  # is filtered explicitly instead of relying on the interface.
  # The console talks to exactly one address. Restrict that user's own traffic
  # rather than the host's, and let the conntrack rule through first so replies
  # to inbound requests still leave.
  networking.nftables.tables.heimdall-egress = {
    family = "inet";
    content = ''
      chain output {
        type filter hook output priority 0; policy accept;
        ct state established,related accept
        meta skuid ${toString config.users.users.heimdall.uid} ip daddr != 192.168.86.2 drop
      }
    '';
  };

  networking.firewall.interfaces."tailscale0".allowedTCPPorts = [ 9140 ];
  networking.firewall.extraInputRules = ''
    ip saddr != { 192.168.86.0/24, 100.64.0.0/10 } tcp dport 9140 drop
    ip saddr 192.168.86.0/24 tcp dport 9140 accept
  '';
}
