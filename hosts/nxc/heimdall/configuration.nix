{ config, pkgs, modulesPath, inputs, outputs, ... }:
let
  # Fixed so the egress rule below can name it; this host runs nothing else.
  heimdallUid = 991;
in
{
  imports = [
    # Autogenerated configuration specific to the iso, and not included in repo
    (modulesPath + "/virtualisation/proxmox-lxc.nix")
  ];

  # Heimdall — read-only Sodola switch console.
  #
  # Phase 1 reads one switch and serves it on 9140. The service is pinned to a
  # reviewed commit of the application repository and runs unprivileged with no
  # ability to reach anything except the switch it reads.
  #
  # Address: 192.168.86.140/24, gateway 192.168.86.1 (assigned by nxc-gen at
  # creation time; there is no network config in this file by design).

  environment.systemPackages = with pkgs; [
    curl
    jq
  ];

  # The hostname comes from Proxmox, not from here: proxmox-lxc.nix defaults
  # manageNetwork and manageHostName to false and, inside that !manageNetwork
  # block, forces networking.hostName to the empty string. With manageNetwork
  # enabled the option would be honoured, so nxc-gen must be given "heimdall".
  system.stateVersion = "26.05";

  extra-services.tailscale = {
    enable = true;
    lxc = true;
  };
  extra-services.host-checkin.enable = true;

  services.openssh.enable = true;

  # Secrets for the console. Every name must exist as a top-level key in
  # secrets/secrets.yaml, or the sops manifest check fails the build. All eight
  # are present on master. They are root-owned, mode 0400, so root can read
  # them. The console service receives them through LoadCredential when it lands.
  sops.secrets = {
    "switch-192-168-86-2-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "switch-192-168-86-3-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "switch-192-168-86-4-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "switch-192-168-86-5-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "switch-192-168-86-6-password" = { owner = "root"; group = "root"; mode = "0400"; };
    "opnsense-console-api" = { owner = "root"; group = "root"; mode = "0400"; };
    "omada-console-openapi" = { owner = "root"; group = "root"; mode = "0400"; };
    "proxmox-console-token" = { owner = "root"; group = "root"; mode = "0400"; };
  };

  # The console's whole configuration. Kept here rather than in the public
  # repository, because it names the site's switch, its management address and
  # the credential to read it with.
  environment.etc."heimdall/config.json".text = builtins.toJSON {
    listen = { host = "0.0.0.0"; port = 9140; };
    poll_seconds = 60;
    switches = [
      # The aggregate switch RSA-encrypts the password against a modulus the
      # device serves first, so a passive capture does not yield it. The older
      # units send it under an unauthenticated MD5 challenge instead. Neither
      # protects against an active attacker on the site LAN, so a read-only
      # switch account is the real mitigation and is not yet in place.
      { name = "HOMELAB-AGG-10G"; family = "hydra"; host = "192.168.86.2"; port = 80;
        scheme = "http"; username = "admin"; credential = "switch-192-168-86-2-password"; }
      { name = "OFFICE-SUB-2.5G"; family = "legacy"; host = "192.168.86.3"; port = 80;
        scheme = "http"; username = "admin"; credential = "switch-192-168-86-3-password"; }
      { name = "HOMELAB-POE-2.5G"; family = "legacy"; host = "192.168.86.4"; port = 80;
        scheme = "http"; username = "admin"; credential = "switch-192-168-86-4-password"; }
      { name = "HOMELAB-DIST-2.5G"; family = "legacy"; host = "192.168.86.6"; port = 80;
        scheme = "http"; username = "admin"; credential = "switch-192-168-86-6-password"; }
    ];

    # How the switches are wired together. The switch-to-switch links below are
    # verified from the forwarding tables: each child's own base MAC is learned
    # on exactly one parent port. The router's end of its link is nominal — the
    # router is not read, so only the aggregate's port 8 is confirmed. The
    # basement unit has no adapter, so it is drawn but not read.
    topology = {
      nodes = [
        { id = "router"; label = "Router (OPNsense)"; kind = "router"; readable = false; }
        { id = "HOMELAB-AGG-10G"; label = "HOMELAB-AGG-10G"; kind = "switch"; readable = true; }
        { id = "HOMELAB-DIST-2.5G"; label = "HOMELAB-DIST-2.5G"; kind = "switch"; readable = true; }
        { id = "HOMELAB-POE-2.5G"; label = "HOMELAB-POE-2.5G"; kind = "switch"; readable = true; }
        { id = "OFFICE-SUB-2.5G"; label = "OFFICE-SUB-2.5G"; kind = "switch"; readable = true; }
        { id = "BASEMENT-POE-1G"; label = "BASEMENT-POE-1G"; kind = "external"; readable = false; }
      ];
      links = [
        { from = "router"; fromPort = 1; to = "HOMELAB-AGG-10G"; toPort = 8; speed = 10000; }
        { from = "HOMELAB-AGG-10G"; fromPort = 6; to = "HOMELAB-POE-2.5G"; toPort = 9; speed = 10000; }
        { from = "HOMELAB-AGG-10G"; fromPort = 7; to = "HOMELAB-DIST-2.5G"; toPort = 9; speed = 10000; }
        { from = "HOMELAB-DIST-2.5G"; fromPort = 1; to = "OFFICE-SUB-2.5G"; toPort = 1; speed = 2500; }
        { from = "HOMELAB-DIST-2.5G"; fromPort = 8; to = "BASEMENT-POE-1G"; toPort = 8; speed = 1000; }
      ];
    };

    # Names for devices the switches only know by address. Taken from the
    # router's lease list, so it goes stale: refresh it when a device is
    # renamed or added.
    names = {
      "00:7c:2d:93:d4:97" = "TIZEN";
      "08:9e:08:bc:b6:65" = "Chromecast";
      "10:3d:1c:e8:8d:8e" = "murdock";
      "12:e0:c9:89:49:d2" = "Lenovo-Idea-Tab-Plus";
      "1c:69:20:84:bd:98" = "espressif";
      "20:58:43:03:91:a6" = "2MQ61304ZP";
      "20:df:b9:13:80:fa" = "Google-Home-Mini";
      "20:f8:3b:09:10:fe" = "home-assistant-voice-0910fe";
      "28:68:47:33:4e:8e" = "Nuki_45320A47";
      "34:46:63:20:64:6a" = "nursery_cam";
      "40:ae:30:40:30:32" = "tp-link-power-strip-3032";
      "48:5f:99:63:e3:0f" = "emma-book";
      "48:b0:2d:e9:93:c8" = "reservation-guest-80";
      "48:ca:43:48:60:e8" = "Toniebox";
      "6c:1c:71:68:51:7e" = "front_door_cam";
      "6c:f2:d8:20:74:29" = "reservation-guest-40";
      "9c:8e:cd:2f:67:16" = "ali_cam";
      "a4:77:33:ff:15:7a" = "Chromecast-Audio";
      "b0:4a:39:a3:6c:3b" = "roborock-vacuum-a65";
      "b0:e4:5c:e6:1e:ce" = "Samsung";
      "bc:24:11:89:f4:13" = "plasma-vm-nixos";
      "cc:db:a7:53:e6:37" = "wled-patio";
      "d4:3a:65:14:43:5b" = "CHOPPF5VLFMK";
      "d8:13:99:3b:aa:85" = "KitchenTV";
      "dc:a6:32:d5:dc:1f" = "pikvm";
      "ee:c9:76:2d:0d:9a" = "iPhone";
      "f4:b1:c2:e6:9a:84" = "back_door_cam";
      "f4:f5:d8:c5:34:3e" = "Google-Home";
    };

  };

  users.users.heimdall = {
    isSystemUser = true;
    group = "heimdall";
    uid = heimdallUid;
  };
  users.groups.heimdall = { };

  systemd.services.heimdall = {
    description = "Heimdall read-only switch console";
    wantedBy = [ "multi-user.target" ];
    after = [ "network-online.target" "firewall.service" ];
    wants = [ "network-online.target" ];
    requires = [ "firewall.service" ];
    # Secrets are written during activation on this host, not by a unit, so
    # there is nothing to order against for them; the only hard dependency is
    # the firewall, which carries both the accept and the egress restriction.
    # A failed poll is handled inside the process, so a restart means a real
    # fault. The interval is widened past RestartSec times the burst so that
    # such a fault stops the unit visibly instead of looping forever.
    startLimitIntervalSec = 60;
    serviceConfig = {
      Type = "simple";
      # The credential file lands in this directory, which the console reads by
      # name. Values never appear in the unit, the config or the environment.
      LoadCredential = [
        "switch-192-168-86-2-password:/run/secrets/switch-192-168-86-2-password"
        "switch-192-168-86-3-password:/run/secrets/switch-192-168-86-3-password"
        "switch-192-168-86-4-password:/run/secrets/switch-192-168-86-4-password"
        "switch-192-168-86-6-password:/run/secrets/switch-192-168-86-6-password"
      ];
      ExecStart = "${inputs.heimdall.packages.${pkgs.stdenv.hostPlatform.system}.default}/bin/heimdall /etc/heimdall/config.json";
      User = "heimdall";
      Group = "heimdall";
      Restart = "always";
      RestartSec = 10;
      StateDirectory = "heimdall";
      StateDirectoryMode = "0700";
      UMask = "0077";
      # Reading switch state needs nothing else.
      CapabilityBoundingSet = "";
      AmbientCapabilities = "";
      NoNewPrivileges = true;
      PrivateTmp = true;
      PrivateDevices = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      ProtectKernelTunables = true;
      ProtectKernelModules = true;
      ProtectControlGroups = true;
      ProtectClock = true;
      ProtectHostname = true;
      RestrictAddressFamilies = [ "AF_INET" ];
      RestrictNamespaces = true;
      RestrictRealtime = true;
      RestrictSUIDSGID = true;
      LockPersonality = true;
      MemoryDenyWriteExecute = true;
      SystemCallArchitectures = "native";
      SystemCallFilter = [ "@system-service" "~@privileged" "~@resources" ];
      # Best effort only: the cgroup-BPF filter this implements needs the bpf
      # controller, which a container's cgroup does not delegate, so inside
      # this LXC it enforces nothing. It is kept only as a second layer where
      # a kernel does support it; the control relied on here is the nftables
      # output rule below, keyed on this service's user, which holds everywhere.
      IPAddressDeny = "any";
      IPAddressAllow = [
        "127.0.0.1/32"
        "100.64.0.0/10"
        "192.168.86.2/32"
        "192.168.86.3/32"
        "192.168.86.4/32"
        "192.168.86.6/32"
      ];
    };
  };

  # Reachable over the tailnet, and from the LAN itself. Guest (192.168.20.0/24)
  # and IoT (192.168.10.0/24) clients can route to this address, so the source
  # is filtered explicitly instead of relying on the interface.
  # The console talks to exactly one address. Restrict that user's own traffic
  # rather than the host's, and let the conntrack rule through first so replies
  # to inbound requests still leave.
  # Keyed on this service's own user, so nothing else on the host is affected.
  # The uid is fixed above for that reason: any account that later lands on it
  # inherits the restriction, which is why this host runs nothing else.
  #
  # This host filters with iptables, so the rules are written for that backend;
  # NixOS offers no output chain of its own, hence extraCommands.
  networking.firewall.extraCommands = ''
    # Order matters. Every rule is deleted first so a reload cannot accumulate
    # duplicates, then the DROP goes in before any ACCEPT: if activation dies
    # half way, the service is over-restricted rather than unconfined. The
    # accepts are then inserted above the DROP, so there is never a moment
    # where this uid has no output restriction at all.
    ip46tables -w -D INPUT -s 192.168.86.0/24 -p tcp --dport 9140 -j nixos-fw-accept 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -p tcp --sport 9140 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 127.0.0.0/8 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.2 -p tcp --dport 80 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.3 -p tcp --dport 80 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.4 -p tcp --dport 80 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.6 -p tcp --dport 80 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.2 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.3 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.4 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.6 -j ACCEPT 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -j DROP 2>/dev/null || true
    ip46tables -w -D OUTPUT -m owner --uid-owner ${toString heimdallUid} -j DROP 2>/dev/null || true
    iptables -w -I nixos-fw 1 -s 192.168.86.0/24 -p tcp --dport 9140 -j nixos-fw-accept
    iptables -w -A OUTPUT -m owner --uid-owner ${toString heimdallUid} -j DROP
    iptables -w -I OUTPUT 1 -m owner --uid-owner ${toString heimdallUid} -p tcp --sport 9140 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    iptables -w -I OUTPUT 1 -m owner --uid-owner ${toString heimdallUid} -d 127.0.0.0/8 -j ACCEPT
    iptables -w -I OUTPUT 1 -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.2 -p tcp --dport 80 -j ACCEPT
    iptables -w -I OUTPUT 1 -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.3 -p tcp --dport 80 -j ACCEPT
    iptables -w -I OUTPUT 1 -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.4 -p tcp --dport 80 -j ACCEPT
    iptables -w -I OUTPUT 1 -m owner --uid-owner ${toString heimdallUid} -d 192.168.86.6 -p tcp --dport 80 -j ACCEPT
    ip6tables -w -A OUTPUT -m owner --uid-owner ${toString heimdallUid} -j DROP
  '';

  networking.firewall.interfaces."tailscale0".allowedTCPPorts = [ 9140 ];
}
