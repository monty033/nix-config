{ config, lib, pkgs, modulesPath, inputs, outputs, ... }:

{
  imports = [
    # Autogenerated configuration specific to the iso, and not included in repo
    (modulesPath + "/virtualisation/proxmox-lxc.nix")
  ];

  extra-services.tailscale = {
    enable = true;
    lxc = true;
  };
  extra-services.host-checkin.enable = true;
  extra-services.mount_general.enable = true;

  # sops secrets configuration
  sops.secrets."nextcloud-admin-password" = {
    owner = "nextcloud";
    group = "nextcloud";
    mode = "0400";
  };
  sops.secrets."nextcloud-secret-file" = {
    owner = "nextcloud";
    group = "nextcloud";
    mode = "0400";
  };
  sops.secrets."nextcloud-db-password" = {
    owner = "nextcloud";
    group = "nextcloud";
    mode = "0400";
  };
  sops.secrets."onlyoffice-jwt-secret" = {
    owner = "onlyoffice";
    group = "onlyoffice";
    mode = "0440";
    restartUnits = [ "onlyoffice-docservice.service" ];
  };
  sops.secrets."onlyoffice-security-nonce" = {
    owner = "onlyoffice";
    group = "onlyoffice";
    mode = "0440";
    restartUnits = [ "onlyoffice-docservice.service" ];
  };

  # Enable the OpenSSH daemon.
  services.openssh.enable = true;

  # Create necessary directories
  systemd.tmpfiles.rules = [
    "d /mnt/drive 0750 nextcloud nextcloud -"
    "d /mnt/general 0750 nextcloud nextcloud -"
  ];

  # optional, but ensures rpc-statsd is running for on demand mounting
  # boot.supportedFilesystems = [ "nfs" ];

  fileSystems."/mnt/drive" = {
    device = "192.168.86.99:/mnt/HDD-Mirror-01/drive";
    fsType = "nfs";
    options = [
      "noatime"
      "rsize=1048576"
      "wsize=1048576"
      "_netdev"
    ];
  };

  services.nextcloud = {
    enable = true;
    hostName = "drive.montycasa.com";
    datadir = "/mnt/drive";
    # Need to manually increment with every major upgrade.
    package = inputs.nixpkgs-unstable.legacyPackages.${pkgs.stdenv.hostPlatform.system}.nextcloud34;
    # Let NixOS install and configure the database automatically.
    database.createLocally = true;
    # Let NixOS install and configure Redis caching automatically.
    configureRedis = true;
    # Increase the maximum file upload size.
    maxUploadSize = "16G";
    https = true;
    autoUpdateApps.enable = true;
    appstoreEnable = true;
    # extraAppsEnable = true;
    # extraApps = with config.services.nextcloud.package.packages.apps; {
    #   # List of apps we want to install and are already packaged in
    #   # https://github.com/NixOS/nixpkgs/blob/master/pkgs/servers/nextcloud/packages/nextcloud-apps.json
    #   inherit calendar contacts notes onlyoffice;
    #   # Custom app example.
    #   # socialsharing_telegram = pkgs.fetchNextcloudApp rec {
    #   #   url =
    #   #     "https://github.com/nextcloud-releases/socialsharing/releases/download/v3.0.1/socialsharing_telegram-v3.0.1.tar.gz";
    #   #   license = "agpl3";
    #   #   sha256 = "sha256-8XyOslMmzxmX2QsVzYzIJKNw6rVWJ7uDhU1jaKJ0Q8k=";
    #   # };
    # };
    secretFile = config.sops.secrets."nextcloud-secret-file".path;
      # passwordsalt
    settings = {
      overwriteprotocol = "https";
      default_phone_region = "US";
      overwritehost = config.services.nextcloud.hostName;
      trusted_proxies = [ "147.182.139.226" "100.84.116.17" "45.33.94.83" "100.106.205.39" ];
      # Quoted so the key stays flat ("overwrite.cli.url"); an unquoted dotted
      # name nests into overwrite -> cli -> url, which Nextcloud does not read.
      "overwrite.cli.url" = "https://${config.services.nextcloud.hostName}";
      # Kept at 1 on purpose: files are written outside Nextcloud on the HDD mirror.
      filesystem_check_changes = 1;
      # Cheaper previews: caps the largest generated size; existing previews are kept.
      preview_max_x = 2048;
      preview_max_y = 2048;
      preview_max_scale_factor = 1;
      # UTC hour; 06:00-10:00 UTC = 02:00-06:00 EDT. Heavy background jobs only.
      maintenance_window_start = 6;
      # Connector settings that must survive rebuilds. allow_local_address lets
      # Nextcloud call the loopback Document Server; the scope is the ONLYOFFICE
      # app only, not every app's outbound requests.
      onlyoffice = {
        allow_local_address = true;
        DocumentServerInternalUrl = "http://127.0.0.1:8100/";
      };
      # trusted_domains = ["192.168.86.136"];
    };
    config = {
      dbtype = "pgsql";
      adminuser = "patrick";
      adminpassFile = config.sops.secrets."nextcloud-admin-password".path;
    };
    # Suggested by Nextcloud's health check.
    phpOptions."opcache.interned_strings_buffer" = "16";
  };

  # /mnt/drive is an NFS mount that holds config.php and the data directory.
  # Without this ordering, nextcloud-setup can start before the mount completes,
  # read the local directory under the mount point, and fail on boot.
  systemd.services.nextcloud-setup = {
    requires = [ "mnt-drive.mount" ];
    after = [ "mnt-drive.mount" ];
  };

  # Gateway-only vhost for container-to-Nextcloud traffic. It listens only on
  # the podman bridge gateway address, on plain HTTP, and only accepts the
  # container network. It does not copy the Nextcloud vhost: it proxies over
  # loopback to the public Nextcloud vhost, so the module's own location rules
  # (denies for /data, /config, .ht*, fastcgi split) stay the single source.
  # It adds no name to the public vhost, does not redirect to HTTPS, and does
  # not widen what port 80 accepts from outside.
  # Reading config.services.nginx.virtualHosts here recursed (this vhost is
  # part of that attribute), so only the plain hostName string is used.
  services.nginx.virtualHosts."container-gateway" = {
    serverName = "host.containers.internal";
    listen = [ { addr = "10.88.0.1"; port = 80; } ];
    extraConfig = ''
      allow 10.88.0.0/16;
      deny all;
    '';
    # The Nextcloud vhost is plain HTTP on port 80 here; TLS terminates at the
    # upstream proxy, so there is no 443 listener on this host to loop back to.
    locations."/" = {
      proxyPass = "http://127.0.0.1:80";
      recommendedProxySettings = false;
      extraConfig = ''
        proxy_set_header Host ${config.services.nextcloud.hostName};
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        client_max_body_size 0;
      '';
    };
  };

  # Point ONLYOFFICE's StorageUrl at the gateway alias. The app-config value in
  # the database takes precedence over system config, so a settings entry
  # cannot change it. This oneshot writes it after each setup run. Rollback must
  # reset it explicitly with occ; reverting this file alone leaves the value.
  systemd.services.nextcloud-onlyoffice-storage-url = {
    description = "Set ONLYOFFICE StorageUrl to the internal Nextcloud alias";
    wantedBy = [ "multi-user.target" ];
    requires = [ "nextcloud-setup.service" ];
    after = [ "nextcloud-setup.service" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = "${config.services.nextcloud.occ}/bin/nextcloud-occ config:app:set onlyoffice StorageUrl --value=http://host.containers.internal/";
    };
  };

  # Nextcloud's own server-side calls to Euro Office (healthcheck, command
  # service, conversion) go straight to the container on the LAN. Browsers keep
  # using the public DocumentServerUrl. Plain HTTP on 8100 is intentional: the
  # container serves HTTP and TLS is terminated at local-proxy, so the internal
  # leg has no certificate hostname to validate. The IP is hardcoded; if the
  # Nextcloud host address changes, update this value.
  systemd.services.nextcloud-onlyoffice-internal-url = {
    description = "Set ONLYOFFICE DocumentServerInternalUrl to the LAN Euro Office address";
    wantedBy = [ "multi-user.target" ];
    requires = [ "nextcloud-setup.service" ];
    after = [ "nextcloud-setup.service" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = "${config.services.nextcloud.occ}/bin/nextcloud-occ config:app:set onlyoffice DocumentServerInternalUrl --value=http://192.168.86.104:8100/";
    };
  };

  # Catch-all for unknown Host headers. Nextcloud's trusted_domains check is
  # bypassed while overwritehost is set (TrustedDomainHelper returns true), so
  # reject unmatched names at nginx instead. Port 80 is open on the host, so
  # this also covers direct connections that skip the bifrost proxy.
  # Named vhosts (drive, theoffice) keep serving their own server_name.
  services.nginx.virtualHosts."_unknown-host" = {
    default = true;
    serverName = "_";
    locations."/" = {
      return = "444";
    };
  };

  # OnlyOffice Document Server
  services.onlyoffice = {
    enable = true;
    hostname = "theoffice.montycasa.com";
    jwtSecretFile = config.sops.secrets."onlyoffice-jwt-secret".path;
    securityNonceFile = config.sops.secrets."onlyoffice-security-nonce".path;
  };

  # Euro-Office DocumentServer: soak candidate on office.montycasa.com.
  # ONLYOFFICE above stays live. The Nextcloud connector is switched by
  # an occ change at cutover, not by this file.
  # Reuses the existing onlyoffice-jwt-secret, so the connector's shared
  # secret does not change and no new SOPS key is needed.
  sops.templates."euro-office-env" = {
    content = ''
      JWT_ENABLED=true
      JWT_SECRET=${config.sops.placeholder."onlyoffice-jwt-secret"}
    '';
    mode = "0400";
  };

  virtualisation.oci-containers = {
    backend = "podman";
    containers.euro-office = {
      # Pinned by digest, not by tag. Tag 9.3.5 is not published.
      image = "ghcr.io/euro-office/documentserver:v9.3.5@sha256:b303064a69d0a4f81ba5945126c4c484fc08bf42436fc97bb85413429e27ba9e";
      autoStart = true;
      # Host 8100 -> container 80 (the health-checked port in the smoke test).
      ports = [ "8100:80" ];
      # Pin the gateway name to the bridge gateway that the container-gateway
      # vhost listens on. Without the pin, podman may resolve the name to a
      # LAN address instead. This name is set as StorageUrl by
      # nextcloud-onlyoffice-storage-url, and renaming services.nextcloud.hostName
      # does not touch it.
      extraOptions = [ "--add-host=host.containers.internal:10.88.0.1" ];
      environmentFiles = [
        config.sops.templates."euro-office-env".path
      ];
    };
  };

  # Enable podman w/ docker socket for AppAPI
  virtualisation.podman = {
    enable = true;
    dockerCompat = true;
    dockerSocket.enable = true;
    defaultNetwork.settings.dns_enabled = true;
  };
  users.users.nextcloud.extraGroups = [ "podman" ];

  networking.firewall.allowedTCPPorts = [ 80 443 8000 8100 ];

  system.stateVersion = "25.05";
}